{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "滴答清单备份助手",
  "version": "1.0.0",
  "identifier": "com.ticktickexport.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd .. && bun run build:desktop",
    "beforeDevCommand": "cd .. && bun scripts/dev-desktop.ts"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "滴答清单备份助手 · Markdown 导出",
        "width": 960,
        "height": 580,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
