{
  "name": "ticktick-export",
  "version": "1.1.0",
  "description": "Export Dida/TickTick official CSV and attachments to a portable ZIP and Markdown vault.",
  "type": "module",
  "license": "MIT",
  "author": "ticktick-export contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/wrightgeoff112-star/ticktick-to-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/wrightgeoff112-star/ticktick-to-markdown/issues"
  },
  "homepage": "https://github.com/wrightgeoff112-star/ticktick-to-markdown#readme",
  "bin": {
    "ticktick-export": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test src/test/*.test.ts",
    "build:desktop": "bun scripts/build-desktop.ts",
    "dev:desktop": "bun run build:desktop && cd desktop && bunx tauri dev",
    "desktop:mac": "bun run build:desktop && cd desktop && bunx tauri build --bundles app,dmg",
    "desktop:windows": "bun run build:desktop && cd desktop && bunx tauri build --bundles nsis",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json --noEmit"
  },
  "keywords": [
    "ticktick",
    "dida365",
    "滴答清单",
    "obsidian",
    "export",
    "markdown",
    "csv"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
