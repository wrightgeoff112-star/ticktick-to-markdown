{
  "manifest_version": 3,
  "name": "滴答清单备份助手",
  "version": "1.0.0",
  "description": "官方 CSV 不含图片和附件。本工具将任务导出为 Markdown，并保存图片与文件附件。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TickTick → Markdown",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://*.dida365.com/*",
    "https://*.ticktick.com/*"
  ]
}
